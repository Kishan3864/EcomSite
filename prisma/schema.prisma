// Mayura — storefront + admin data model.
//
// Conventions
//   • Money is stored as whole rupees (Int). Every storefront price is a whole
//     rupee and GST is included, so paise would only add noise.
//   • Order lines snapshot the product (title, price, image) at purchase time.
//     A later catalogue edit must never rewrite what a customer bought.
//   • Denormalised counters (rating, reviewCount, soldCount, stock) live on
//     Product and are recomputed by the admin actions that change them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/* ------------------------------------------------------------------ */
/*  Enums                                                              */
/* ------------------------------------------------------------------ */

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductBadge {
  BESTSELLER
  NEW
  TRENDING
  LIMITED
  EXCLUSIVE
  HANDPICKED
}

enum VariantType {
  COLOR
  SIZE
  STORAGE
  OPTION
}

enum RelationKind {
  RELATED
  BUNDLE
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum QuestionStatus {
  PENDING
  ANSWERED
  HIDDEN
}

enum OfferType {
  PERCENT
  FLAT
  SHIPPING
  BANK
}

enum BannerPlacement {
  HERO
  MID
  PROMO_TILE
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum CustomerTier {
  SILVER
  GOLD
  PEACOCK_CLUB
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  COD_PENDING
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  COD
}

enum DeliverySpeed {
  STANDARD
  EXPRESS
  SCHEDULED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  PICKED_UP
  REFUNDED
  REJECTED
}

enum AdminRole {
  OWNER
  MANAGER
  STAFF
}

enum MessageStatus {
  NEW
  REPLIED
  CLOSED
}

/* ------------------------------------------------------------------ */
/*  Catalogue                                                          */
/* ------------------------------------------------------------------ */

model Brand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  logoText    String
  tagline     String
  origin      String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive])
}

model Category {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  menuLabel          String
  icon               String   @default("tag")
  accent             String   @default("#2c837c")
  description        String
  imageUrl           String
  imageAlt           String
  highlights         String[] @default([])
  featuredBrandSlugs String[] @default([])
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  subcategories Subcategory[]
  products      Product[]
  offers        Offer[]

  @@index([isActive, sortOrder])
}

model Subcategory {
  id          String   @id @default(cuid())
  slug        String
  name        String
  description String
  imageUrl    String
  imageAlt    String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@unique([categoryId, slug])
  @@index([categoryId, isActive, sortOrder])
}

model Product {
  id                String         @id @default(cuid())
  slug              String         @unique
  sku               String         @unique
  title             String
  subtitle          String
  description       String
  status            ProductStatus  @default(ACTIVE)
  price             Int
  mrp               Int
  currency          String         @default("INR")
  stock             Int            @default(0)
  lowStockThreshold Int            @default(10)
  soldCount         Int            @default(0)
  rating            Float          @default(0)
  reviewCount       Int            @default(0)
  badges            ProductBadge[] @default([])
  tags              String[]       @default([])
  colors            String[]       @default([])
  highlights        String[]       @default([])
  /// [{ group: string, items: [{ label: string, value: string }] }]
  specifications    Json           @default("[]")
  deliveryDays      Int            @default(3)
  codAvailable      Boolean        @default(true)
  returnWindowDays  Int            @default(10)
  warranty          String         @default("6 months against manufacturing defects")
  freeShipping      Boolean        @default(true)
  videoPoster       String?
  metaTitle         String?
  metaDescription   String?
  brandId           String
  brand             Brand          @relation(fields: [brandId], references: [id])
  categoryId        String
  category          Category       @relation(fields: [categoryId], references: [id])
  subcategoryId     String
  subcategory       Subcategory    @relation(fields: [subcategoryId], references: [id])
  publishedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  images        ProductImage[]
  variantGroups VariantGroup[]
  reviews       Review[]
  questions     Question[]
  orderLines    OrderLine[]
  relationsFrom ProductRelation[] @relation("relationFrom")
  relationsTo   ProductRelation[] @relation("relationTo")
  stockMoves    StockMovement[]

  @@index([status, categoryId, subcategoryId])
  @@index([brandId])
  @@index([status, createdAt])
  @@index([status, soldCount])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
}

model VariantGroup {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  type      VariantType
  sortOrder Int         @default(0)

  options VariantOption[]

  @@index([productId, sortOrder])
}

model VariantOption {
  id         String       @id @default(cuid())
  groupId    String
  group      VariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label      String
  value      String
  swatch     String?
  priceDelta Int          @default(0)
  inStock    Boolean      @default(true)
  sortOrder  Int          @default(0)

  @@index([groupId, sortOrder])
}

model ProductRelation {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation("relationFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedId String
  related   Product      @relation("relationTo", fields: [relatedId], references: [id], onDelete: Cascade)
  kind      RelationKind
  sortOrder Int          @default(0)

  @@unique([productId, relatedId, kind])
  @@index([productId, kind, sortOrder])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  reference String?
  actorName String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

/* ------------------------------------------------------------------ */
/*  Social proof                                                       */
/* ------------------------------------------------------------------ */

model Review {
  id           String       @id @default(cuid())
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  author       String
  location     String
  rating       Int
  title        String
  body         String
  images       String[]     @default([])
  verified     Boolean      @default(false)
  helpfulCount Int          @default(0)
  status       ReviewStatus @default(APPROVED)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}

model Question {
  id         String         @id @default(cuid())
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  question   String
  answer     String?
  askedBy    String
  answeredBy String?
  answeredAt DateTime?
  upvotes    Int            @default(0)
  status     QuestionStatus @default(ANSWERED)
  createdAt  DateTime       @default(now())

  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}

/* ------------------------------------------------------------------ */
/*  Marketing                                                          */
/* ------------------------------------------------------------------ */

model Offer {
  id          String    @id @default(cuid())
  code        String    @unique
  title       String
  description String
  type        OfferType
  value       Int
  minSpend    Int       @default(0)
  maxDiscount Int?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  accent      String    @default("#2c837c")
  startsAt    DateTime  @default(now())
  expiresAt   DateTime
  usageLimit  Int?
  usedCount   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, expiresAt])
}

model Banner {
  id        String          @id @default(cuid())
  placement BannerPlacement
  eyebrow   String          @default("")
  title     String
  subtitle  String          @default("")
  cta       String          @default("Shop now")
  href      String
  imageUrl  String
  imageAlt  String          @default("")
  align     String          @default("left")
  theme     String          @default("dark")
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
}

/* ------------------------------------------------------------------ */
/*  Customers                                                          */
/* ------------------------------------------------------------------ */

model Customer {
  id            String       @id @default(cuid())
  email         String       @unique
  phone         String?
  name          String
  passwordHash  String?
  tier          CustomerTier @default(SILVER)
  loyaltyPoints Int          @default(0)
  isActive      Boolean      @default(true)
  notes         String?
  lastLoginAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  returns   ReturnRequest[]

  @@index([createdAt])
}

model Address {
  id         String       @id @default(cuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      AddressLabel @default(HOME)
  fullName   String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  pincode    String
  isDefault  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([customerId])
}

/* ------------------------------------------------------------------ */
/*  Orders                                                             */
/* ------------------------------------------------------------------ */

model Order {
  id     String @id @default(cuid())
  number String @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Guests check out too; these are always filled so support can reach anyone.
  contactName  String
  contactEmail String
  contactPhone String

  status        OrderStatus   @default(CONFIRMED)
  paymentStatus PaymentStatus @default(PAID)
  paymentMethod PaymentMethod
  paymentDetail String?
  paymentRef    String?

  deliverySpeed DeliverySpeed @default(STANDARD)
  deliveryName  String
  deliveryPrice Int           @default(0)
  scheduledDate DateTime?
  giftWrap      Boolean       @default(false)

  // Shipping address snapshot — the customer may edit their saved address later.
  shipLabel    String  @default("Home")
  shipName     String
  shipPhone    String
  shipLine1    String
  shipLine2    String?
  shipLandmark String?
  shipCity     String
  shipState    String
  shipPincode  String

  itemsTotal      Int
  mrpTotal        Int
  productDiscount Int     @default(0)
  couponCode      String?
  couponDiscount  Int     @default(0)
  shipping        Int     @default(0)
  tax             Int     @default(0)
  total           Int

  courier           String?
  awb               String?
  estimatedDelivery DateTime
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  customerNote      String?
  adminNote         String?
  placedAt          DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  lines   OrderLine[]
  events  OrderEvent[]
  returns ReturnRequest[]

  @@index([status, placedAt])
  @@index([customerId, placedAt])
  @@index([contactEmail])
  @@index([placedAt])
}

model OrderLine {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  slug         String
  title        String
  brand        String
  categorySlug String
  image        String
  variantLabel String?
  variantKey   String?
  price        Int
  mrp          Int
  quantity     Int

  returns ReturnRequest[]

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  title       String
  description String
  location    String
  at          DateTime    @default(now())
  actorName   String?

  @@index([orderId, at])
}

model ReturnRequest {
  id           String       @id @default(cuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLineId  String
  orderLine    OrderLine    @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reason       String
  details      String?
  status       ReturnStatus @default(REQUESTED)
  refundAmount Int
  refundMode   String
  adminNote    String?
  requestedAt  DateTime     @default(now())
  resolvedAt   DateTime?
  updatedAt    DateTime     @updatedAt

  @@index([status, requestedAt])
  @@index([orderId])
}

/* ------------------------------------------------------------------ */
/*  Inbox                                                              */
/* ------------------------------------------------------------------ */

model ContactMessage {
  id          String        @id @default(cuid())
  name        String
  email       String
  topic       String
  orderNumber String?
  message     String
  status      MessageStatus @default(NEW)
  reply       String?
  repliedAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("footer")
  createdAt DateTime @default(now())
}

/* ------------------------------------------------------------------ */
/*  Admin                                                              */
/* ------------------------------------------------------------------ */

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  /// Bumped to invalidate every existing session for this user.
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  activity ActivityLog[]
}

model ActivityLog {
  id        String     @id @default(cuid())
  actorId   String?
  actor     AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String
  action    String
  entity    String
  entityId  String?
  summary   String
  metadata  Json?
  createdAt DateTime   @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

/// Key/value store for things the owner edits from Settings.
model StoreSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
