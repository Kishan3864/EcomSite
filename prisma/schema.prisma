model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  /// Bumped to invalidate every existing session for this user.
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  activity ActivityLog[]
  uploads  MediaAsset[]
  refunds  Refund[]
}

model ActivityLog {
  id        String     @id @default(cuid())
  actorId   String?
  actor     AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String
  action    String
  entity    String
  entityId  String?
  summary   String
  metadata  Json?
  createdAt DateTime   @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

/// Key/value store for things the owner edits from Settings.
/// Product page views per day — a bare counter for the homepage ranking.
/// Deliberately holds nothing about the visitor: no id, IP, cookie or agent.
model ProductViewDaily {
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  views     Int      @default(0)

  @@id([productId, day])
  @@index([day])
}

model StoreSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum PaymentAttemptStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

/// One attempt to pay for an order.
///
/// An order can carry several: a customer whose UPI request times out will
/// simply try again, and each try gets its own gateway records. Keeping them
/// separate is what lets support answer "where did my money go" precisely
/// rather than guessing from a single overwritten column.
model PaymentAttempt {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Our transaction id, sent to the gateway before the customer pays.
  gatewayOrderId   String  @unique
  /// The gateway's own payment id, once there is a payment to have one.
  gatewayPaymentId String? @unique

  /// Paise, as the gateway counts it — never rupees. Storing what was actually
  /// sent to the gateway is what makes a mismatch detectable later.
  amount   Int
  currency String @default("INR")

  status PaymentAttemptStatus @default(CREATED)

  /// upi, card, netbanking, wallet — as the gateway reports it.
  method String?
  /// Which UPI app the customer chose, where the gateway tells us.
  upiApp String?

  failureCode        String?
  failureDescription String?

  /// The gateway's own payload, kept verbatim for reconciliation and disputes.
  /// This is the *capture* response and nothing else may overwrite it — a
  /// refund keeps its own payload on its own row.
  payload Json?

  /// ---- What the money did after the sale ----------------------------
  ///
  /// Everything below arrives from PayU's get_Transaction_Details, days after
  /// the payment itself, and is null until it does. It is the difference
  /// between "the customer paid" and "the money reached the bank", which is
  /// the question the owner actually asks at the end of a month.

  /// The bank or wallet PayU routed this through, as PayU names it.
  bankName   String?
  /// The instrument, already masked by PayU — 512345XXXXXX2346, or the UPI
  /// handle. Never a full card number: PayU does not send one and we must not
  /// store one.
  cardMasked String?

  /// PayU's own commission on this sale, in paise.
  ///
  /// PayU reports fees as rupees with two decimals, which paise hold exactly.
  /// Where a rate works out to a fraction of a paisa PayU has already rounded
  /// it before sending, and we round again to the nearest paisa on the way in;
  /// the bank statement is the authority if the two ever disagree.
  gatewayFee    Int?
  /// GST on that commission, in paise. Same rounding note as above.
  gatewayFeeTax Int?

  /// PayU's id for the batch this sale was paid out in.
  settlementId  String?
  /// What actually landed in the bank for this sale, in paise — the amount
  /// less PayU's fee and its tax. Not the same number as `amount`, and that
  /// difference is the point of storing both.
  settledAmount Int?
  /// The bank's UTR for that payout. This is the number to quote when the
  /// owner cannot find the money in his statement.
  utrNumber     String?
  /// The date the bank values the payout at, as PayU reports it. A date, not a
  /// moment — PayU sends no time of day.
  valueDate     DateTime?

  /// When we last asked PayU for the settlement picture above, so a sweep can
  /// skip what it has already seen. Null means never asked.
  settlementSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds Refund[]

  @@index([orderId])
  @@index([status])
}

/// Where a refund has got to, in PayU's own words.
///
/// These are PayU's check_action_status values, kept verbatim rather than
/// flattened into our PaymentStatus, because the wait is the answer support
/// has to give: REQUESTED and OD_HIT mean five to seven working days, QUEUED
/// means PayU has it but the bank has not. Collapsing them would throw that
/// away. `describeRefundEta` in src/lib/payments/refund-status.ts is the one
/// place those sentences are written.
enum RefundStatus {
  QUEUED
  IN_PROGRESS
  REQUESTED
  SUCCESS
  FAILURE
  OD_HIT
}

/// One refund we asked PayU to make.
///
/// The row is written BEFORE PayU is called, not after. A refund that was sent
/// and then lost to a timeout is the one failure that costs real money twice,
/// so the record of having asked has to survive the asking. Everything PayU
/// says afterwards is written back onto this same row.
///
/// Refunds are never deleted and never edited by hand. Together they are the
/// only honest answer to "how much of this order has actually gone back",
/// which `Order.paymentStatus` on its own cannot give — three different code
/// paths write that flag.
model Refund {
  id String @id @default(cuid())

  /// The attempt whose money this gives back. A refund belongs to one capture,
  /// not to an order: a duplicate payment leaves an order with two captured
  /// attempts and only one of them is being refunded.
  paymentAttemptId String
  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)
  /// Carried alongside so the admin can list an order's refunds without
  /// walking through its attempts.
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Our own token for this refund — PayU's var2, which it will not take
  /// longer than 23 characters and will not accept twice.
  ///
  /// That refusal is what makes a double click harmless: the same token
  /// resubmitted finds this row already here and sends nothing, and if it
  /// somehow did reach PayU a second time PayU would reject it as a duplicate
  /// rather than pay it out again.
  token String @unique

  /// PayU's id for the request, returned by cancel_refund_transaction. It is
  /// the only handle check_action_status answers to. Null until PayU has
  /// answered — a null here on an older row means we asked and never heard
  /// back, which is a state for a human to look at, not for code to retry.
  requestId String? @unique

  /// Paise, matching PaymentAttempt.amount — never rupees. PayU is told rupees
  /// with two decimals; the conversion happens once, on the way out.
  amount Int

  status RefundStatus @default(QUEUED)

  /// PayU's replies, verbatim — the acknowledgement and the latest status
  /// check. Kept for the same reason PaymentAttempt.payload is: when money is
  /// disputed, what the gateway actually said is the evidence.
  payload Json?

  /// Why PayU refused, in PayU's words, when it did.
  failureReason String?

  /// Who pressed the button. The name is denormalised the way ActivityLog
  /// denormalises it, so the record still says who did this after the admin
  /// account is gone.
  initiatedById   String?
  initiatedBy     AdminUser? @relation(fields: [initiatedById], references: [id], onDelete: SetNull)
  initiatedByName String
  /// The moment a person decided, which is also the moment this row was
  /// written — before PayU knew anything about it.
  initiatedAt     DateTime   @default(now())

  /// When we last asked PayU what became of this. Null means not since it was
  /// raised.
  lastCheckedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([paymentAttemptId])
}

/// A profile photo the customer uploaded.
///
/// Kept out of the Customer row on purpose: Prisma selects every scalar column
/// by default, and a customer is read on nearly every request. Bytes in that
/// row would ride along with every session check.
model CustomerAvatar {
  customerId String   @id
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Random and unguessable, and replaced on every upload. It is the URL, so a
  /// new photo is a new address and no cache ever serves the old one.
  key        String   @unique
  mime       String
  data       Bytes
  updatedAt  DateTime @updatedAt
}

/// An image uploaded through the admin panel.
///
/// Stored in the database rather than on disk, for the same reason customer
/// photos are: a deploy replaces the application directory, and a file written
/// beside it is a file nobody backs up. Here it travels with `pg_dump` and
/// survives every deploy without anyone having to remember it.
model MediaAsset {
  id        String   @id @default(cuid())
  /// Random and unguessable, and part of the URL — so a replaced image is a new
  /// address and no cache anywhere ever serves the old bytes.
  key       String   @unique
  filename  String
  mime      String
  bytes     Int
  data      Bytes
  /// What the picture shows. Copied into alt text when the image is used.
  alt       String   @default("")
  createdAt DateTime @default(now())

  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
