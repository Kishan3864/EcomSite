// Mayura — storefront + admin data model.
//
// Conventions
//   • Money is stored as whole rupees (Int). Every storefront price is a whole
//     rupee and GST is included, so paise would only add noise.
//   • Order lines snapshot the product (title, price, image) at purchase time.
//     A later catalogue edit must never rewrite what a customer bought.
//   • Denormalised counters (rating, reviewCount, soldCount, stock) live on
//     Product and are recomputed by the admin actions that change them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Enums
 */
/**
 * ------------------------------------------------------------------
 */

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductBadge {
  BESTSELLER
  NEW
  TRENDING
  LIMITED
  EXCLUSIVE
  HANDPICKED
}

enum VariantType {
  COLOR
  SIZE
  STORAGE
  OPTION
}

enum RelationKind {
  RELATED
  BUNDLE
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum QuestionStatus {
  PENDING
  ANSWERED
  HIDDEN
}

enum BannerPlacement {
  HERO
  MID
  PROMO_TILE
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum CustomerTier {
  SILVER
  GOLD
  PEACOCK_CLUB
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  /// UPI only: the customer says they have paid and gave a UTR, and the owner
  /// has not yet checked the bank. Never treat this as money received.
  VERIFYING
  PAID
  COD_PENDING
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  /// Paid through the gateway checkout, before the gateway has said how.
  /// Narrowed to UPI / CARD / NETBANKING / WALLET once the payment lands.
  ONLINE
  UPI
  CARD
  NETBANKING
  WALLET
  COD
}

enum DeliverySpeed {
  STANDARD
  EXPRESS
  SCHEDULED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  PICKED_UP
  REFUNDED
  REJECTED
}

enum AdminRole {
  OWNER
  MANAGER
  STAFF
}

enum MessageStatus {
  NEW
  REPLIED
  CLOSED
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Catalogue
 */
/**
 * ------------------------------------------------------------------
 */

model Brand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  logoText    String
  tagline     String
  origin      String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive])
}

model Category {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  menuLabel          String
  icon               String   @default("tag")
  accent             String   @default("#2c837c")
  description        String
  imageUrl           String
  imageAlt           String
  highlights         String[] @default([])
  featuredBrandSlugs String[] @default([])
  /// Inherited by products in this category that set none of their own.
  defaultHsnCode     String?
  defaultTaxRate     Float?
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  subcategories Subcategory[]
  products      Product[]

  @@index([isActive, sortOrder])
}

model Subcategory {
  id          String   @id @default(cuid())
  slug        String
  name        String
  description String
  imageUrl    String
  imageAlt    String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@unique([categoryId, slug])
  @@index([categoryId, isActive, sortOrder])
}

/// A wholesaler the shop buys from.
///
/// ADMIN ONLY. This is the shop's own buying record — who a product was bought
/// from, so that months later the owner can find the same wholesaler again. It
/// is not part of the catalogue a shopper sees and must never be shown, listed,
/// linked or serialised anywhere on the storefront. See the note on
/// `Product.supplierId` for the exact files that keep it that way.
model Supplier {
  id   String @id @default(cuid())
  /// URL-safe handle, so the admin product list can filter by `?supplier=…`
  /// the same way it filters by brand.
  slug String @unique
  name String

  /// Who to ask for at that wholesaler. A market supplier is a person before
  /// it is a firm, and the name is usually the only way back to them.
  contactName String
  phone       String
  email       String?
  /// Their GSTIN, for matching a purchase invoice to this row later.
  gstin       String?
  city        String?
  /// Terms, minimum order, which market they sit in — whatever the owner wants
  /// to remember. Free text on purpose.
  notes       String?

  /// A wholesaler the shop has stopped buying from is deactivated, never
  /// deleted: the products bought from them keep their history.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive])
}

model Product {
  id                String         @id @default(cuid())
  slug              String         @unique
  sku               String         @unique
  title             String
  subtitle          String
  description       String
  status            ProductStatus  @default(ACTIVE)
  price             Int
  mrp               Int
  currency          String         @default("INR")
  /// HSN for goods (SAC for services) — printed on every tax invoice.
  hsnCode           String?
  /// GST percentage for this item; falls back to the category, then to Settings.
  taxRate           Float?
  /// Unique Quantity Code — Rule 46 asks for the unit alongside the quantity.
  uqc               String?        @default("NOS")
  stock             Int            @default(0)
  lowStockThreshold Int            @default(10)
  /// Packed weight in grams, for the courier's booking and its rate card.
  weightGrams       Int            @default(1000)
  soldCount         Int            @default(0)
  rating            Float          @default(0)
  reviewCount       Int            @default(0)
  badges            ProductBadge[] @default([])
  tags              String[]       @default([])
  colors            String[]       @default([])
  highlights        String[]       @default([])
  /// [{ group: string, items: [{ label: string, value: string }] }]
  specifications    Json           @default("[]")
  deliveryDays      Int            @default(3)
  codAvailable      Boolean        @default(true)
  returnWindowDays  Int            @default(10)
  warranty          String         @default("6 months against manufacturing defects")
  freeShipping      Boolean        @default(true)
  videoPoster       String?
  metaTitle         String?
  metaDescription   String?
  /// The product page's H1, when it should say more than the title — a size or
  /// the key spec. Null falls back to `title`. Cards, the cart, invoices and
  /// structured data keep using `title`; only the page heading reads this.
  headline          String?
  brandId           String
  brand             Brand          @relation(fields: [brandId], references: [id])
  categoryId        String
  category          Category       @relation(fields: [categoryId], references: [id])
  subcategoryId     String
  subcategory       Subcategory    @relation(fields: [subcategoryId], references: [id])

  /// Which wholesaler this product was bought from.
  ///
  /// ADMIN ONLY, and the owner was plain about it: "wahan ye achha nahi
  /// lagega". Nothing derived from this column may reach a shopper. The
  /// storefront reads products with `include`, so this value IS loaded on
  /// every storefront query — what keeps it off the page is that five
  /// hand-written allowlists never mention it. Do not add a supplier field to
  /// any of them: `Product` in src/lib/types.ts, `toProduct` in
  /// src/services/catalog.ts, `toCardModel` in src/lib/card.ts, the `select`
  /// in src/services/search-docs.ts, or `ProductJsonLd` in
  /// src/components/seo/json-ld.tsx. The admin reads it from the Prisma row
  /// directly instead.
  ///
  /// Those five cover the product-BROWSING path. There is a second,
  /// independent route from a customer-facing page to this column:
  /// OrderLine.product. Two reads walk OrderLine today — `orderInclude` in
  /// src/services/orders.ts, which feeds the storefront order page,
  /// /track/[id] and /account/orders, and the `lines` include in
  /// src/services/invoice.ts, which renders the invoice a customer downloads.
  /// Both are safe only because they take OrderLine SCALARS and never
  /// traverse the relation. Neither may grow `include: { product: ... }` —
  /// adding it to recover a live HSN code, a weight or an image the line
  /// snapshot lacks would put the wholesaler onto a document the customer
  /// downloads, without touching any of the five files named above.
  ///
  /// Optional because the catalogue came first: a product bought before anyone
  /// was writing this down simply has no answer, and that is not an error.
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  /// What one unit cost to buy, in whole rupees.
  ///
  /// ADMIN ONLY, exactly like `supplierId` above and guarded the same way: the
  /// five storefront allowlists named there must never mention it, and no
  /// customer-facing read may traverse OrderLine.product. The admin reads it
  /// from the Prisma row. Null means "not recorded", which is what every
  /// product bought before this column existed says.
  costPrice Int?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  images        ProductImage[]
  variantGroups VariantGroup[]
  reviews       Review[]
  viewDays      ProductViewDaily[]
  questions     Question[]
  orderLines    OrderLine[]
  relationsFrom ProductRelation[]  @relation("relationFrom")
  relationsTo   ProductRelation[]  @relation("relationTo")
  stockMoves    StockMovement[]

  @@index([status, categoryId, subcategoryId])
  @@index([brandId])
  @@index([supplierId])
  @@index([status, createdAt])
  @@index([status, soldCount])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
}

model VariantGroup {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  type      VariantType
  sortOrder Int         @default(0)

  options VariantOption[]

  @@index([productId, sortOrder])
}

model VariantOption {
  id         String       @id @default(cuid())
  groupId    String
  group      VariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label      String
  value      String
  swatch     String?
  priceDelta Int          @default(0)
  inStock    Boolean      @default(true)
  sortOrder  Int          @default(0)

  @@index([groupId, sortOrder])
}

model ProductRelation {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation("relationFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedId String
  related   Product      @relation("relationTo", fields: [relatedId], references: [id], onDelete: Cascade)
  kind      RelationKind
  sortOrder Int          @default(0)

  @@unique([productId, relatedId, kind])
  @@index([productId, kind, sortOrder])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  reference String?
  actorName String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Social proof
 */
/**
 * ------------------------------------------------------------------
 */

model Review {
  id           String       @id @default(cuid())
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  author       String
  location     String
  rating       Int
  title        String
  body         String
  images       String[]     @default([])
  verified     Boolean      @default(false)
  helpfulCount Int          @default(0)
  status       ReviewStatus @default(APPROVED)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}

model Question {
  id         String         @id @default(cuid())
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  question   String
  answer     String?
  askedBy    String
  answeredBy String?
  answeredAt DateTime?
  upvotes    Int            @default(0)
  status     QuestionStatus @default(ANSWERED)
  createdAt  DateTime       @default(now())

  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Marketing
 */
/**
 * ------------------------------------------------------------------
 */

model Banner {
  id        String          @id @default(cuid())
  placement BannerPlacement
  eyebrow   String          @default("")
  title     String
  subtitle  String          @default("")
  cta       String          @default("Shop now")
  href      String
  imageUrl  String
  imageAlt  String          @default("")
  align     String          @default("left")
  theme     String          @default("dark")
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Customers
 */
/**
 * ------------------------------------------------------------------
 */

model Customer {
  id              String       @id @default(cuid())
  email           String       @unique
  phone           String?
  /// Set only once the customer has proved the number with an SMS code, so an
  /// OTP sign-in never opens an account someone typed a number into. E.164.
  verifiedPhone   String?      @unique
  phoneVerifiedAt DateTime?
  name            String
  /// Null for accounts that only ever signed in through a provider.
  passwordHash    String?
  tier            CustomerTier @default(SILVER)
  loyaltyPoints   Int          @default(0)
  isActive        Boolean      @default(true)
  notes           String?
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  /// Pre-selected at checkout so a returning customer is not asked twice.
  preferredPayment PaymentMethod?
  /// Their own UPI handle, offered as the default at the payment step.
  upiId            String?

  /// Federated sign-in. `providerId` is the provider's own subject id.
  authProvider  AuthProvider    @default(PASSWORD)
  providerId    String?
  avatarUrl     String?
  /// A photo the customer uploaded themselves. Wins over avatarUrl.
  avatar        CustomerAvatar?
  emailVerified Boolean         @default(false)

  addresses   Address[]
  orders      Order[]
  reviews     Review[]
  returns     ReturnRequest[]
  messages    ContactMessage[]
  resetTokens PasswordResetToken[]

  @@unique([authProvider, providerId])
  @@index([createdAt])
}

/// One-time codes sent by SMS. Only a keyed hash of the code is stored, and
/// rows are pruned after two days; they also back the per-number send limits.
model PhoneOtp {
  id         String     @id @default(cuid())
  /// E.164, e.g. +919876543210.
  phone      String
  purpose    OtpPurpose
  /// For LINK: the signed-in customer the number is being added to.
  customerId String?
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime   @default(now())

  @@index([phone, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}

enum OtpPurpose {
  /// Sign in, or start an account, with a mobile number.
  LOGIN
  /// Add a verified number to an account that is already signed in.
  LINK
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  FACEBOOK
}

model Address {
  id         String       @id @default(cuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      AddressLabel @default(HOME)
  fullName   String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  pincode    String
  isDefault  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([customerId])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Orders
 */
/**
 * ------------------------------------------------------------------
 */

model Order {
  id     String @id @default(cuid())
  number String @unique

  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Guests check out too; these are always filled so support can reach anyone.
  contactName  String
  contactEmail String
  contactPhone String

  status        OrderStatus      @default(CONFIRMED)
  paymentStatus PaymentStatus    @default(PAID)
  paymentMethod PaymentMethod
  paymentDetail String?
  paymentRef    String?
  /// Every attempt made against this order, successful or not.
  payments      PaymentAttempt[]
  /// Every refund raised against this order, whatever became of it.
  refunds       Refund[]

  deliverySpeed DeliverySpeed @default(STANDARD)
  deliveryName  String
  deliveryPrice Int           @default(0)
  scheduledDate DateTime?
  giftWrap      Boolean       @default(false)

  // Shipping address snapshot — the customer may edit their saved address later.
  shipLabel    String  @default("Home")
  shipName     String
  shipPhone    String
  shipLine1    String
  shipLine2    String?
  shipLandmark String?
  shipCity     String
  shipState    String
  shipPincode  String

  itemsTotal      Int
  mrpTotal        Int
  productDiscount Int @default(0)
  shipping        Int @default(0)
  tax             Int @default(0)
  total           Int

  /// Tax invoice, frozen at the moment it was raised. A GSTIN or a registered
  /// address the shop changes next year must not rewrite last year's invoices,
  /// so the seller's details are copied here rather than read from Settings.
  invoiceNumber     String?   @unique
  invoiceDate       DateTime?
  sellerLegalName   String?
  sellerAddress     String?
  sellerGstin       String?
  sellerStateCode   String?
  /// Where the goods are delivered: it decides CGST+SGST against IGST.
  placeOfSupply     String?
  placeOfSupplyCode String?
  /// Given by a business buyer who needs the invoice for input credit.
  buyerGstin        String?

  courier           String?
  awb               String?
  /// When the courier's tracking was last pulled into the timeline.
  trackingSyncedAt  DateTime?
  estimatedDelivery DateTime
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  customerNote      String?
  adminNote         String?
  /// Which lifecycle emails have already gone out for this order, as kind
  /// slugs ("shipped", "delivered"). A retried webhook or a second click in
  /// admin therefore cannot send the same mail twice. Additive: an order that
  /// predates this column has an empty list and is simply treated as never
  /// having been emailed.
  emailsSent        String[]  @default([])
  placedAt          DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  lines    OrderLine[]
  events   OrderEvent[]
  returns  ReturnRequest[]
  messages ContactMessage[]

  @@index([status, placedAt])
  @@index([customerId, placedAt])
  @@index([contactEmail])
  @@index([placedAt])
}

model OrderLine {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  slug         String
  title        String
  brand        String
  categorySlug String
  image        String
  variantLabel String?
  variantKey   String?
  price        Int
  mrp          Int
  quantity     Int
  /// Snapshotted with the line: an invoice must read the same years later,
  /// even after the product's HSN or the shop's GST rate has been changed.
  hsnCode      String?
  taxRate      Float    @default(18)
  uqc          String   @default("NOS")

  returns ReturnRequest[]

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  title       String
  description String
  location    String
  at          DateTime    @default(now())
  actorName   String?

  @@index([orderId, at])
}

model ReturnRequest {
  id           String       @id @default(cuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLineId  String
  orderLine    OrderLine    @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reason       String
  details      String?
  status       ReturnStatus @default(REQUESTED)
  refundAmount Int
  refundMode   String
  adminNote    String?
  requestedAt  DateTime     @default(now())
  resolvedAt   DateTime?
  updatedAt    DateTime     @updatedAt

  @@index([status, requestedAt])
  @@index([orderId])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Inbox
 */
/**
 * ------------------------------------------------------------------
 */

model ContactMessage {
  id          String        @id @default(cuid())
  name        String
  email       String
  topic       String
  orderNumber String?
  message     String
  status      MessageStatus @default(NEW)
  reply       String?
  repliedAt   DateTime?
  createdAt   DateTime      @default(now())

  /// Who sent it, as far as the server can tell. All nullable: every message
  /// stored before these columns existed has none of them, and a guest has no
  /// customerId. These are also the rate limiter's counters — there is no
  /// separate counter table, because a stored message *is* the record that one
  /// was sent, and unlike an in-memory map it survives a deploy.
  /// The IP as nginx saw it (X-Real-IP), never as the client claimed it.
  ip         String?
  /// Our own cookie value. Best effort: cleared cookies or a strict private
  /// window start a new one. Not a browser fingerprint, deliberately.
  deviceId   String?
  /// Set when the sender was signed in; also what the admin badge reads.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Truncated, for triage only.
  userAgent  String?
  /// Set when the order number given matches a real order, so admin can open
  /// it in one click. Resolved once, at submit; never guessed afterwards.
  orderId    String?
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([ip, createdAt])
  @@index([email, createdAt])
  @@index([deviceId, createdAt])
  @@index([customerId, createdAt])
}

/// Why a contact submission was refused.
enum ContactAbuseReason {
  COOLDOWN
  DAILY_CAP
  HONEYPOT
  TOO_FAST
  VALIDATION
  LINK_SPAM
  BLOCKED
}

/**
 * Every refused contact submission, so an attack is visible in admin rather
 * than silently absorbed.
 * The message body is never stored here. A refused submission is unvetted text
 * from an unknown sender, and keeping it would make this table the very thing
 * the contact form is being protected from. `detail` holds a short machine-written
 * note (which limit, how long is left), never anything the sender typed.
 */
model ContactAbuse {
  id         String             @id @default(cuid())
  reason     ContactAbuseReason
  ip         String?
  email      String?
  deviceId   String?
  customerId String?
  userAgent  String?
  detail     String?
  createdAt  DateTime           @default(now())

  @@index([createdAt])
  @@index([ip, createdAt])
}

/// What a ContactBlock matches on.
enum ContactBlockKind {
  IP
  EMAIL
}

/**
 * The manual blocklist behind the admin "block this IP/email" button. Checked
 * before anything else, and a blocked sender is told the same thing a
 * rate-limited one is — a blocklist that announces itself is a blocklist
 * someone tunes their way around.
 */
model ContactBlock {
  id        String           @id @default(cuid())
  kind      ContactBlockKind
  value     String
  reason    String?
  createdBy String?
  createdAt DateTime         @default(now())

  @@unique([kind, value])
}

/**
 * A single-use, expiring password-reset ticket.
 * Only a SHA-256 hash of the token is stored: the value that goes in the email
 * exists nowhere on the server, so a database leak hands over nothing that can
 * be redeemed. usedAt is what makes it genuinely single-use — a stateless
 * signed token cannot be retired once issued, and a reset link that still works
 * after the password has been changed is a way back in for whoever read the
 * mailbox first.
 */
model PasswordResetToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token, hex. Never the token itself.
  tokenHash  String    @unique
  expiresAt  DateTime
  /// Set the moment it is redeemed; a used ticket is never accepted again.
  usedAt     DateTime?
  /// Kept only to show "requested from" if a customer disputes a reset.
  requestIp  String?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([expiresAt])
}

model NewsletterSubscriber {
  id         String    @id @default(cuid())
  email      String    @unique
  source     String    @default("footer")
  createdAt  DateTime  @default(now())
  /// When the welcome email went out; null until it has, so it is sent once.
  welcomedAt DateTime?
}

