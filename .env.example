# Copy to .env and fill in. See README "Database & admin" for details.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mayura?schema=public"
AUTH_SECRET="replace-with-64-random-chars"
NEXT_PUBLIC_SITE_URL="https://ecom.flexypdf.com"
ADMIN_SEED_EMAIL="admin@mayura.in"
ADMIN_SEED_PASSWORD="change-me-on-first-login"

# Optional social sign-in. Leave a pair out and that button is not rendered at all.
# Register the callback shown in deploy/README.md against each client id.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ── Razorpay ──────────────────────────────────────────────────────────────
# Test keys come from the dashboard the moment you sign up; live keys only
# after KYC is approved. The secret and the webhook secret are server-only —
# neither is ever sent to the browser.
#
# RAZORPAY_WEBHOOK_SECRET must be the exact string you typed into
# Dashboard → Account & Settings → Webhooks. It is not the key secret, and a
# mismatch makes every webhook fail signature verification silently.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Mobile OTP sign-in (MSG91) ────────────────────────────────────────────
# Leave empty and the "Mobile number" sign-in tab is not shown in production.
# (In development the code is printed to the server console instead.)
# The template must be DLT-approved, with its {#var#} mapped to ##otp##.
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""
# Hard ceiling on SMS sent per day across the whole site (fraud protection).
OTP_DAILY_LIMIT="300"

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────
# The newsletter welcome email is sent from this Gmail account. GMAIL_APP_PASSWORD
# is a 16-character App Password (Google Account → Security → 2-Step
# Verification → App passwords), never the account's own password.
# Leave either empty and no email is sent; subscribing still works.
GMAIL_USER="weekendscart@gmail.com"
GMAIL_APP_PASSWORD=""
