# Copy to .env and fill in. See README "Database & admin" for details.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mayura?schema=public"
AUTH_SECRET="replace-with-64-random-chars"
NEXT_PUBLIC_SITE_URL="https://ecom.flexypdf.com"
ADMIN_SEED_EMAIL="admin@mayura.in"
ADMIN_SEED_PASSWORD="change-me-on-first-login"

# Optional social sign-in. Leave a pair out and that button is not rendered at all.
# Register the callback shown in deploy/README.md against each client id.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""


# ── Mobile OTP sign-in (MSG91) ────────────────────────────────────────────
# Leave empty and the "Mobile number" sign-in tab is not shown in production.
# (In development the code is printed to the server console instead.)
# The template must be DLT-approved, with its {#var#} mapped to ##otp##.
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""
# Hard ceiling on SMS sent per day across the whole site (fraud protection).
OTP_DAILY_LIMIT="300"

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────
# The newsletter welcome email is sent from this Gmail account. GMAIL_APP_PASSWORD
# is a 16-character App Password (Google Account → Security → 2-Step
# Verification → App passwords), never the account's own password.
# Leave either empty and no email is sent; subscribing still works.
GMAIL_USER="weekendscart@gmail.com"
GMAIL_APP_PASSWORD=""

# ── Courier (Delhivery One) ───────────────────────────────────────────────
# Leave the token empty and the product page pincode checker falls back to the
# shop-wide delivery promise, and the admin panel books nothing — every order is
# still shippable by booking on Delhivery One and typing the AWB in by hand.
#
# Delhivery One issues a live token only (Settings → API and MCP Setup). Test
# on the live account by booking one parcel and cancelling it before pickup —
# an unpicked shipment is never billed. If Delhivery ever gives you a staging
# token, set "staging" and the same code talks to their test system instead.
DELHIVERY_ENV="production"
DELHIVERY_API_TOKEN=""
# The warehouse name exactly as registered in Delhivery One → Settings → Pickup locations.
DELHIVERY_PICKUP_LOCATION=""

# ── UPI (paid straight into the shop's bank account) ──────────────────────
# Leave UPI_VPA empty and the UPI option does not appear at checkout at all.
#
# This is not a secret: it is printed on the QR every shopper scans. It lives
# here so it can be changed without a deploy.
#
# Use a BUSINESS UPI id (Google Pay for Business, PhonePe for Business, or one
# your bank issued for the current account). Collecting shop payments on a
# personal UPI id is against the bank's own terms and is how accounts get
# frozen.
UPI_VPA=""
# The name UPI apps show the payer. Defaults to the legal name in
# src/config/business.ts. Keep it recognisable — a payer who does not recognise
# the name abandons the payment.
UPI_PAYEE_NAME=""

# ── PayU (the payment gateway) ────────────────────────────────────────────
# Leave PAYU_KEY empty and "Pay online" does not appear at checkout.
#
# From the PayU dashboard → Developers → API Keys. The TEST key and salt are
# different from the live pair: switch the dashboard to Test Mode to see them.
# Nothing about the integration differs between the two — PAYU_MODE picks the
# endpoint, and that is the whole of going live.
#
# The salt is what proves a payment really came from PayU. Treat it exactly
# like a password: never in the browser, never in a form field, never logged.
PAYU_MODE="test"            # "test" or "live"
PAYU_KEY=""
PAYU_SALT=""
# Only needed for the newer REST APIs (payment links, refunds). The checkout
# itself does not use them.
PAYU_CLIENT_ID=""
PAYU_CLIENT_SECRET=""
