#!/usr/bin/env bash
# Git hook: the emergency door, kept shut.
#
# Installed into ~/weekendcart.git/hooks/post-receive by
# deploy/setup-push-deploy.sh. It runs on the server when someone does
# `git push production main` from their PC.
#
# It refuses, on purpose.
#
# Why: pushing straight to this box puts code on the server that GitHub has
# never seen. The next ordinary deploy — which pulls from GitHub — then resets
# the app to whatever GitHub last had, and the work that was only ever pushed
# here disappears off the live site. That is not hypothetical; it is how a whole
# redesign was quietly rolled back hours after it went live.
#
# So there is one way in: GitHub. From your PC,
#
#   npm run deploy
#
# which pushes to GitHub and then has this box pull from it.
#
# ── When GitHub really is unreachable from here ───────────────────────────
# Open the door for as long as you need it, on the server:
#
#   touch ~/.deploy-allow-direct        # then push; deploys as before
#   rm ~/.deploy-allow-direct           # shut it again, straight afterwards
#
# and push the same commits to GitHub from your PC as soon as you can, because
# until you do, the next normal deploy will roll the server back to GitHub's
# version. The hook says so again on its way out.
set -euo pipefail

APP_DIR="${DEPLOY_APP_DIR:-$HOME/ecom.flexypdf.com}"
BRANCH="${DEPLOY_BRANCH:-main}"
TARGET="${DEPLOY_TARGET:-production}"
ESCAPE_HATCH="$HOME/.deploy-allow-direct"

# A hook runs with GIT_DIR (and friends) pointing at the bare repo. Left set,
# every git command below would operate on the wrong repository.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_QUARANTINE_PATH GIT_PREFIX

while read -r _old _new ref; do
  [ "$ref" = "refs/heads/$BRANCH" ] || continue

  if [ ! -e "$ESCAPE_HATCH" ]; then
    printf '\n\033[1;31m✗ Direct pushes to the server are turned off.\033[0m\n\n'
    printf '  GitHub is the only source of truth for what is live. Deploy with:\n\n'
    printf '      \033[1mnpm run deploy\033[0m\n\n'
    printf '  which pushes to GitHub and then has this box pull from it.\n\n'
    printf '  The commits you just pushed are sitting in this bare repo and have\n'
    printf '  NOT been deployed. Nothing on the shop has changed.\n\n'
    printf '  If GitHub is genuinely unreachable from this server, see the notes at\n'
    printf '  the top of deploy/post-receive for the temporary way round.\n\n'
    exit 1
  fi

  printf '\n\033[1;33m▸ Direct push allowed (%s exists) — deploying\033[0m\n' "$ESCAPE_HATCH"
  cd "$APP_DIR"

  # `local` is this box's bare repo, a directory away. No network involved.
  git fetch --quiet local
  git reset --hard --quiet "local/$BRANCH"

  DEPLOY_SKIP_PULL=1 bash deploy/deploy.sh "$TARGET"

  printf '\n\033[1;33m  Reminder: GitHub does not have these commits.\033[0m\n'
  printf '\033[1;33m  Push them from your PC (git push origin %s), or the next\033[0m\n' "$BRANCH"
  printf '\033[1;33m  normal deploy will reset this server back to GitHub.\033[0m\n'
  printf '\033[1;33m  Then: rm %s\033[0m\n\n' "$ESCAPE_HATCH"
done
