node_modules
.next
# Every build directory, not a list of the four we happened to think of.
# deploy.sh builds into .next-build and keeps .next-prev / .next-failed, and a
# NEXT_DIST_DIR set by hand for a one-off check is just as much build output —
# one of those got as far as being committed because it was not on the list.
.next-*

# Kept across deploys, outside any release: the optimised-image cache.
/shared/
out
build
.DS_Store
*.pem
npm-debug.log*
.env*
!.env.example
next-env.d.ts
.vercel
*.tsbuildinfo

# local dev database cluster + generated prisma client
.pgdata
src/generated

# release bookkeeping written on the server by deploy/deploy.sh
.last-release
.last-install

# Google signing keys, cached so a sign-in never waits on the network
.cache
logs

# written and removed by scripts/check-visibility.ts --all-off within one run
.check-visibility-recovery.json
